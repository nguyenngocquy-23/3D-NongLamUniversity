# 3D Virtual Tour System - Performance Test Environment Variables

# API Base URLs
API_BASE_URL=http://localhost:8080/app/api
STAGING_API_BASE_URL=https://staging.3dtour.io.vn/app/api
PRODUCTION_API_BASE_URL=https://3dtour.io.vn/app/api

# Test Environment
TEST_ENVIRONMENT=staging
TEST_DATABASE_URL=jdbc:mysql://localhost:3306/virtual_nlu_test
TEST_DATABASE_USER=test_user
TEST_DATABASE_PASSWORD=test_password

# Authentication
TEST_ADMIN_USERNAME=admin@test.com
TEST_ADMIN_PASSWORD=admin123
TEST_USER_USERNAME=user@test.com
TEST_USER_PASSWORD=user123

# Cloudinary Configuration (for mock uploads)
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Test Data
TEST_TOUR_IDS=1,2,3,4,5
TEST_NODE_IDS=10,11,12,13,14,15
TEST_SPACE_IDS=1,2,3

# Performance Test Configuration
MAX_VIRTUAL_USERS=100
RAMP_UP_TIME=60s
TEST_DURATION=300s
THINK_TIME_MIN=1
THINK_TIME_MAX=5

# File Upload Test Configuration
TEST_IMAGE_PATH=./test-data/sample-360-image.jpg
TEST_IMAGE_SIZE_MB=5
MAX_CONCURRENT_UPLOADS=10

# Monitoring
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=your_org
INFLUXDB_BUCKET=k6_metrics

# Cleanup Configuration
CLEANUP_TEST_DATA=true
CLEANUP_INTERVAL_HOURS=24
