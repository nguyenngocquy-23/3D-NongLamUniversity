<web-app>
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>vn.edu.hcmuaf.virtualnluapi.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <context-param>
        <param-name>resteasy.disable.default.exception.mapper</param-name>
        <param-value>true</param-value>
    </context-param>
</web-app>
